{
  "rules": {
    ".read": false,
    ".write": false,

    "notifications": {
      "$nickname": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$notifId": {
          ".validate": "newData.hasChildren(['type', 'title', 'message', 'createdAt', 'read'])",
          "type": { ".validate": "newData.isString()" },
          "title": { ".validate": "newData.isString()" },
          "message": { ".validate": "newData.isString()" },
          "read": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isString()" }
        }
      }
    },

    "productionRequests": {
      ".read": "auth != null",
      ".indexOn": ["ipId", "requesterNickname"],
      "$reqId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ipId', 'requesterNickname', 'status', 'requestedAt'])",
        "ipId": { ".validate": "newData.isString()" },
        "requesterNickname": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'done' || newData.val() == 'rejected' || newData.val() == 'cancelled')" },
        "price": { ".validate": "newData.isNumber()" },
        "requestedAt": { ".validate": "newData.isString()" }
      }
    },

    "ipReviews": {
      ".read": "auth != null",
      ".indexOn": ["ipId", "requesterNickname"],
      "$reviewId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ipId', 'requesterNickname', 'stepKey', 'status', 'requestedAt'])",
        "ipId": { ".validate": "newData.isString()" },
        "requesterNickname": { ".validate": "newData.isString()" },
        "stepKey": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'reviewed')" },
        "requestedAt": { ".validate": "newData.isString()" }
      }
    },

    "ipOverallComments": {
      ".read": "auth != null",
      "$ipId": {
        ".write": "auth != null",
        ".validate": "newData.isString() || newData.val() == null"
      }
    },

    "publicIPs": {
      ".read": "auth != null",
      "$ipId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'title'])",
        "id": { ".validate": "newData.isString()" },
        "title": { ".validate": "newData.isString()" }
      }
    },

    "allIPs": {
      ".read": "auth != null",
      "$ipId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'title'])",
        "id": { ".validate": "newData.isString()" },
        "title": { ".validate": "newData.isString()" }
      }
    },

    "publicCreators": {
      ".read": "auth != null",
      "$nickname": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['nickname', 'positions'])",
        "nickname": { ".validate": "newData.isString()" }
      }
    },

    "positions": {
      ".read": "auth != null",
      "$posId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'ipTitle', 'role', 'ownerNickname'])",
        "id": { ".validate": "newData.isString()" },
        "ipTitle": { ".validate": "newData.isString()" },
        "role": { ".validate": "newData.isString()" },
        "ownerNickname": { ".validate": "newData.isString()" },
        "count": { ".validate": "newData.isNumber()" },
        "filled": { ".validate": "newData.isNumber()" }
      }
    },

    "ipJoinRequests": {
      ".read": "auth != null",
      "$ipId": {
        "$reqId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id', 'name', 'ipId', 'status', 'requestedAt'])",
          "name": { ".validate": "newData.isString()" },
          "ipId": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'accepted' || newData.val() == 'rejected')" },
          "requestedAt": { ".validate": "newData.isString()" }
        }
      }
    },

    "positionApplicants": {
      ".read": "auth != null",
      "$posId": {
        "$appId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id', 'name', 'status', 'appliedAt'])",
          "name": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'accepted' || newData.val() == 'rejected')" },
          "appliedAt": { ".validate": "newData.isString()" }
        }
      }
    },

    "ipFollowers": {
      ".read": "auth != null",
      "$ipId": {
        "$nickname": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'followedAt'])",
          "name": { ".validate": "newData.isString()" },
          "followedAt": { ".validate": "newData.isString()" }
        }
      }
    },

    "episodeLikes": {
      ".read": "auth != null",
      "$ipId": {
        "$episodeId": {
          "$nickname": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['name', 'likedAt'])",
            "name": { ".validate": "newData.isString()" },
            "likedAt": { ".validate": "newData.isString()" }
          }
        }
      }
    },

    "episodeComments": {
      ".read": "auth != null",
      "$ipId": {
        "$episodeId": {
          "$commentId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id', 'name', 'text', 'createdAt'])",
            "name": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString()" },
            "createdAt": { ".validate": "newData.isString()" }
          }
        }
      }
    },

    "episodeViews": {
      ".read": "auth != null",
      "$ipId": {
        "$episodeId": {
          "$nickname": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['name', 'viewedAt'])",
            "name": { ".validate": "newData.isString()" },
            "viewedAt": { ".validate": "newData.isString()" }
          }
        }
      }
    },

    "ipViews": {
      ".read": "auth != null",
      "$ipId": {
        "$nickname": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'viewedAt'])",
          "name": { ".validate": "newData.isString()" },
          "viewedAt": { ".validate": "newData.isString()" }
        }
      }
    },

    "dmThreads": {
      ".read": "auth != null",
      "$threadId": {
        "participants": {
          "$nickname": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString()" },
            "joinedAt": { ".validate": "newData.isString()" }
          }
        },
        "messages": {
          "$msgId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['from', 'text', 'createdAt'])",
            "from": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString()" },
            "createdAt": { ".validate": "newData.isString()" }
          }
        }
      }
    },

    "ipDetails": {
      "$ipId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "ipMaterials": {
      "$ipId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "accounts": {
      "$nickname": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['pinHash', 'salt', 'iterations', 'createdAt'])",
        "pinHash": { ".validate": "newData.isString()" },
        "salt": { ".validate": "newData.isString()" },
        "iterations": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isString()" }
      }
    },

    "reports": {
      ".read": "auth != null",
      "$reportId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['type', 'reporter', 'targetNickname', 'targetId', 'reason', 'status', 'createdAt'])",
        "type": { ".validate": "newData.isString()" },
        "reporter": { ".validate": "newData.isString()" },
        "targetNickname": { ".validate": "newData.isString()" },
        "targetId": { ".validate": "newData.isString()" },
        "reason": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isString()" }
      }
    },

    "crewChat": {
      ".read": "auth != null",
      "$ipId": {
        "$msgId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'text', 'createdAt'])",
          "name": { ".validate": "newData.isString()" },
          "text": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isString()" }
        }
      }
    },

    "ipCheers": {
      ".read": "auth != null",
      "$ipId": {
        "$nickname": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'cheeredAt'])",
          "name": { ".validate": "newData.isString()" },
          "cheeredAt": { ".validate": "newData.isString()" }
        }
      }
    }
  }
}
